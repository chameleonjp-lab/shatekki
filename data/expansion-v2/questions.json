      "text_ja": "景品の見取り図",
      "group": "GUIDE"
    },
    "B": {
      "text_ja": "小さな遊びのカード",
      "group": "MIX"
    }
  },
  {
    "id": "Q009",
    "text_ja": "店主に一つだけお願いするなら？",
