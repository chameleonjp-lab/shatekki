      "group": "MIX"
    }
  },
  {
    "id": "Q014",
    "text_ja": "屋台を一日借りられるなら？",
    "A": {
      "text_ja": "景品選びを楽しむ",
      "group": "STOCK"
    },
    "B": {
      "text_ja": "遊びの仕掛けを試す",
      "group": "RISK"
    }
  },
  {
    "id": "Q015",
    "text_ja": "店主から「ひと工夫」と頼まれたら？",
    "A": {
      "text_ja": "道具を使いやすくする",
      "group": "GAIN"
    },
    "B": {
      "text_ja": "案内を分かりやすくする",
      "group": "GUIDE"
    }
  },
  {
    "id": "Q016",
    "text_ja": "店先のくじ箱、引き方を選ぶなら？",
