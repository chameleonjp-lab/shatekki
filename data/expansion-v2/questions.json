[
  {
    "id": "Q001",
    "text_ja": "屋台の入口、どちらから見て回る？",
    "A": {
      "text_ja": "看板が気になる方",
      "group": "GUIDE"
    },
    "B": {
      "text_ja": "景品が並ぶ方",
      "group": "STOCK"
    }
  },
  {
    "id": "Q002",
    "text_ja": "開店まで少しある。何をして待つ？",
    "A": {
      "text_ja": "腕をほぐす",
      "group": "GAIN"
    },
    "B": {
      "text_ja": "店主とじゃんけん",
      "group": "RISK"
    }
  },
  {
    "id": "Q003",
    "text_ja": "店の呼び込みを頼まれたら？",
